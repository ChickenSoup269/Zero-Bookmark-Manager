{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.8.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "zero-bookmark-manager@chickensoup269.dev",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "webNavigation",
    "identity",
    "alarms",
    "notifications"
  ],
  "optional_host_permissions": ["https://urlhaus-api.abuse.ch/*"],
  "action": {
    "default_title": "Zero Bookmark Manager"
  },
  "sidebar_action": {
    "default_panel": "index.html",
    "default_title": "Zero Bookmark Manager",
    "default_icon": "icons/icon.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "128": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.ttf",
        "fonts/*.woff2",
        "images/*.png",
        "images/*.jpg",
        "bookmarks.html",
        "components/sidepanel/sidepanel.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Open Extension Action"
    }
  }
}
